generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                   @id @default(cuid())
  email              String                   @unique
  passwordHash       String
  name               String
  employeeId         String?                  @unique
  role               String
  active             Boolean                  @default(true)
  dateOfJoining      DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  assignmentSubs     AssignmentSubmission[]
  dailySubmissions   DailySubmission[]
  discussions        DiscussionComment[]
  enrollments        Enrollment[]
  learningStreak     LearningStreak?
  lessonNotes        LessonNote[]
  lessonProgress     LessonProgress[]
  createdProjects    Project[]                @relation("ProjectCreator")
  createdAssignments ProjectAssignment[]      @relation("AssignmentCreator")
  projectAssignments ProjectAssignment[]      @relation("ProjectAssignments")
  certifications     ProjectCertification[]
  certificationReviews ProjectCertification[] @relation("CertificationReviewer")
  qaReviews          QAReview[]               @relation("QAReviewer")
  quizAttempts       QuizAttempt[]
  qaAssignments      TraineeProfile[]         @relation("QAAssignments")
  trainerAssignments TraineeProfile[]         @relation("TrainerAssignments")
  traineeProfile     TraineeProfile?
  trainerReviews     TrainerReview[]          @relation("TrainerReviewer")
  dayWorkReviewsGiven DayWorkReview[]         @relation("DayWorkReviewer")
  dayWorkReviewsReceived DayWorkReview[]      @relation("DayWorkTrainee")
  workMetricsRecorded TraineeWorkMetric[]     @relation("WorkMetricRecorder")
  workMetrics         TraineeWorkMetric[]     @relation("WorkMetricTrainee")
  achievements       UserAchievement[]
  createdCategories  ProjectCategory[]  @relation("CategoryCreator")
  checklistProgress UserChecklistProgress[]
  progressOverridesMade LessonProgressOverride[] @relation("ProgressOverrideActor")
  progressOverrides     LessonProgressOverride[] @relation("ProgressOverrideTrainee")
  finalEvaluationAttempts FinalEvaluationAttempt[]
  finalQuizCertificates FinalQuizCertificate[]
  finalQuizCertReviews  FinalQuizCertificate[] @relation("FinalQuizCertReviewer")
  finalQuizRetakesGranted TraineeProfile[]     @relation("FinalQuizRetakeGranter")
  finalQuizRetakeGrantsReceived FinalQuizRetakeGrant[] @relation("FinalQuizRetakeTrainee")
  finalQuizRetakeGrantsGiven    FinalQuizRetakeGrant[] @relation("FinalQuizRetakeGranterAudit")
  @@map("user")
}

model ProjectCertification {
  id           String    @id @default(cuid())
  userId       String
  projectId    String
  score        Float
  passed       Boolean
  /// PENDING_REVIEW | APPROVED | REJECTED | FAILED
  status       String    @default("PENDING_REVIEW")
  certifiedAt  DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  reviewNote   String?   @db.Text
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?     @relation("CertificationReviewer", fields: [reviewedById], references: [id])

  @@unique([userId, projectId])
  @@index([projectId], map: "ProjectCertification_projectId_fkey")
  @@index([status])
  @@index([reviewedById])
  @@map("projectcertification")
}

model TraineeProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  projectAssigned    String?
  trainerId          String?
  qaId               String?
  trainingStarted    Boolean  @default(false)
  trainingStatus     String   @default("REGISTERED")
  readyForProduction Boolean  @default(false)
  currentDayNumber   Int      @default(0)
  /// Admin/TL can force the trainee onto this day (or later) even if earlier checklist is incomplete.
  forcedCurrentDayNumber Int?
  /// Increments when Admin adds an extra week so a new final-quiz attempt is allowed.
  evaluationCycle    Int      @default(1)
  /// Set when Admin / Team Lead allows a final-quiz retake; cleared when the retake is submitted.
  finalQuizRetakeGrantedAt   DateTime?
  finalQuizRetakeGrantedById String?
  finalQuizRetakePreviousScore Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  qa                 User?    @relation("QAAssignments", fields: [qaId], references: [id])
  trainer            User?    @relation("TrainerAssignments", fields: [trainerId], references: [id])
  finalQuizRetakeGrantedBy User? @relation("FinalQuizRetakeGranter", fields: [finalQuizRetakeGrantedById], references: [id])
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([qaId], map: "TraineeProfile_qaId_fkey")
  @@index([trainerId], map: "TraineeProfile_trainerId_fkey")
  @@index([finalQuizRetakeGrantedById])
  @@map("traineeprofile")
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  thumbnail   String?
  published   Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules          Module[]
  enrollments      Enrollment[]
  completionRules  CompletionRule[]
  prerequisites    Prerequisite[]     @relation("CoursePrereq")
  requiredFor      Prerequisite[]     @relation("PrereqCourse")
  @@map("course")
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int      @default(0)
  lessons     Lesson[]
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId], map: "Module_courseId_fkey")
  @@map("module")
}

model Lesson {
  id              String                @id @default(cuid())
  moduleId        String
  title           String
  description     String?
  order           Int                   @default(0)
  lessonType      String                @default("CONTENT")
  durationMin     Int?
  assignment      Assignment?
  discussions     DiscussionComment[]
  module          Module                @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  notes           LessonNote[]
  progress        LessonProgress[]
  progressOverrides LessonProgressOverride[]
  quizzes         Quiz[]
  topics          Topic[]
  curriculumLinks CurriculumDayLesson[]

  @@index([moduleId], map: "Lesson_moduleId_fkey")
  @@map("lesson")
}

model Topic {
  id          String  @id @default(cuid())
  lessonId    String
  title       String
  contentType String
  contentUrl  String?
  contentBody String?
  order       Int     @default(0)
  durationSec Int?
  lesson      Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId], map: "Topic_lessonId_fkey")
  @@map("topic")
}

model Quiz {
  id           String         @id @default(cuid())
  lessonId     String
  title        String
  passingScore Int            @default(70)
  order        Int            @default(0)
  lesson       Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts     QuizAttempt[]
  questions    QuizQuestion[]

  @@index([lessonId], map: "Quiz_lessonId_fkey")
  @@map("quiz")
}

model QuizQuestion {
  id          String @id @default(cuid())
  quizId      String?
  quiz        Quiz?  @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question    String @db.Text
  options     String @db.Text
  correct     String @db.Text
  order       Int    @default(0)

  @@index([quizId], map: "QuizQuestion_quizId_fkey")
  @@map("quizquestion")
}

model Assignment {
  id           String                 @id @default(cuid())
  lessonId     String                 @unique
  title        String
  instructions String?
  lesson       Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions  AssignmentSubmission[]
  @@map("assignment")
}

model Prerequisite {
  id             String @id @default(cuid())
  courseId       String
  prereqCourseId String
  course         Course @relation("CoursePrereq", fields: [courseId], references: [id], onDelete: Cascade)
  prereqCourse   Course @relation("PrereqCourse", fields: [prereqCourseId], references: [id], onDelete: Cascade)

  @@index([courseId], map: "Prerequisite_courseId_fkey")
  @@index([prereqCourseId], map: "Prerequisite_prereqCourseId_fkey")
  @@map("prerequisite")
}

model CompletionRule {
  id                String  @id @default(cuid())
  courseId          String
  requireAllLessons Boolean @default(true)
  requireQuizPass   Boolean @default(true)
  minWatchPercent   Int     @default(90)
  course            Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId], map: "CompletionRule_courseId_fkey")
  @@map("completionrule")
}

model Enrollment {
  id              String    @id @default(cuid())
  userId          String
  courseId        String
  status          String    @default("NOT_STARTED")
  progressPercent Float     @default(0)
  lastLessonId    String?
  lastActivityAt  DateTime?
  totalTimeSec    Int       @default(0)
  enrolledAt      DateTime  @default(now())
  completedAt     DateTime?
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId], map: "Enrollment_courseId_fkey")
  @@map("enrollment")
}

model LessonProgress {
  id             String    @id @default(cuid())
  userId         String
  lessonId       String
  completed      Boolean   @default(false)
  watchPercent   Float     @default(0)
  timeSpentSec   Int       @default(0)
  quizScore      Float?
  quizPassed     Boolean   @default(false)
  assignmentDone Boolean   @default(false)
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt
  lesson         Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId], map: "LessonProgress_lessonId_fkey")
  @@map("lessonprogress")
}

// Audit trail when Admin/Team Lead marks a lesson done or resets it
model LessonProgressOverride {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("ProgressOverrideTrainee", fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  action      String
  reason      String?  @db.Text
  changedById String
  changedBy   User     @relation("ProgressOverrideActor", fields: [changedById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([lessonId])
  @@index([changedById])
  @@map("lessonprogressoverride")
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId      String?
  quiz        Quiz?    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score       Float
  passed      Boolean
  answers     String   @db.Text
  createdAt   DateTime @default(now())

  @@index([quizId], map: "QuizAttempt_quizId_fkey")
  @@index([userId], map: "QuizAttempt_userId_fkey")
  @@map("quizattempt")
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  userId       String
  assignmentId String
  content      String?
  submittedAt  DateTime   @default(now())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assignmentId], map: "AssignmentSubmission_assignmentId_fkey")
  @@index([userId], map: "AssignmentSubmission_userId_fkey")
  @@map("assignmentsubmission")
}

model LearningStreak {
  id            String    @id @default(cuid())
  userId        String    @unique
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastLearnDate DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("learningstreak")
}

model Achievement {
  id          String            @id @default(cuid())
  code        String            @unique
  title       String
  description String?
  icon        String?
  milestone   Int?
  users       UserAchievement[]
  @@map("achievement")
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime    @default(now())
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([achievementId], map: "UserAchievement_achievementId_fkey")
  @@map("userachievement")
}

model LessonNote {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  content   String
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId], map: "LessonNote_lessonId_fkey")
  @@map("lessonnote")
}

model DiscussionComment {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  content   String
  createdAt DateTime @default(now())
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lessonId], map: "DiscussionComment_lessonId_fkey")
  @@index([userId], map: "DiscussionComment_userId_fkey")
  @@map("discussioncomment")
}

// Day-wise onboarding + training curriculum (Admin/TL curated)
// scopeKey = "GLOBAL" (default for everyone) OR a trainee userId (personal schedule)
model CurriculumDay {
  id          String   @id @default(cuid())
  scopeKey    String   @default("GLOBAL")
  dayNumber   Int
  title       String
  /// MIXED = checklist + lessons + work; CHECKLIST / TRAINING kept as focus labels
  dayType     String   @default("MIXED")
  projectName String?
  /// HRMS mytfs.project.project_id when a practice project is attached to this day
  hrmsProjectId String?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  checklistItems CurriculumChecklistItem[]
  lessons        CurriculumDayLesson[]

  @@unique([scopeKey, dayNumber])
  @@index([scopeKey])
  @@index([hrmsProjectId])
  @@map("curriculumday")
}

model CurriculumChecklistItem {
  id          String   @id @default(cuid())
  dayId       String
  title       String
  description String?  @db.Text
  /// CHECKLIST = onboarding ticks; WORK = hands-on training tasks
  kind        String   @default("CHECKLIST")
  /// Assigned working hours for WORK items (shown to trainee)
  assignedHours Float?
  sortOrder   Int      @default(0)
  day         CurriculumDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  progress    UserChecklistProgress[]

  @@index([dayId])
  @@map("curriculumchecklistitem")
}

model CurriculumDayLesson {
  id        String   @id @default(cuid())
  dayId     String
  lessonId  String
  label     String?
  sortOrder Int      @default(0)
  day       CurriculumDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([dayId, lessonId])
  @@index([dayId])
  @@index([lessonId])
  @@map("curriculumdaylesson")
}

model UserChecklistProgress {
  id          String   @id @default(cuid())
  userId      String
  itemId      String
  completed   Boolean  @default(false)
  completedAt DateTime?
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item        CurriculumChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
  @@index([itemId])
  @@map("userchecklistprogress")
}

/// One global final evaluation quiz (unlocks after all day-wise training is complete).
model FinalEvaluationQuiz {
  id           String   @id @default(cuid())
  title        String
  description  String?  @db.Text
  passingScore Int      @default(90)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  questions    FinalEvaluationQuestion[]
  attempts     FinalEvaluationAttempt[]
  @@map("finalevaluationquiz")
}

model FinalEvaluationQuestion {
  id       String              @id @default(cuid())
  quizId   String
  question String              @db.Text
  /// JSON array of option strings
  options  String              @db.Text
  correct  String
  sortOrder Int                @default(0)
  quiz     FinalEvaluationQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("finalevaluationquestion")
}

/// One attempt per user per quiz per evaluationCycle (no requiz within a cycle).
model FinalEvaluationAttempt {
  id        String              @id @default(cuid())
  userId    String
  quizId    String
  cycle     Int                 @default(1)
  score     Float
  passed    Boolean
  answers   String              @db.Text
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz      FinalEvaluationQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  certificate FinalQuizCertificate?

  @@unique([userId, quizId, cycle])
  @@index([userId])
  @@index([quizId])
  @@map("finalevaluationattempt")
}

/// Issued when a trainee completes the Final Quiz (one per attempt / cycle).
model FinalQuizCertificate {
  id           String   @id @default(cuid())
  userId       String
  attemptId    String   @unique
  quizTitle    String
  score        Float
  cycle        Int      @default(1)
  /// PENDING_REVIEW until Admin / Team Lead approves; APPROVED when visible to trainee.
  status       String   @default("PENDING_REVIEW")
  certifiedAt  DateTime @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  reviewNote   String?  @db.Text
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt      FinalEvaluationAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  reviewedBy   User?    @relation("FinalQuizCertReviewer", fields: [reviewedById], references: [id])

  @@index([userId])
  @@index([status])
  @@map("finalquizcertificate")
}

/// Audit log when Admin / Team Lead allows a final-quiz retake.
model FinalQuizRetakeGrant {
  id            String   @id @default(cuid())
  userId        String
  grantedById   String
  grantedAt     DateTime @default(now())
  previousCycle Int
  newCycle      Int
  previousScore Float
  user          User     @relation("FinalQuizRetakeTrainee", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy     User     @relation("FinalQuizRetakeGranterAudit", fields: [grantedById], references: [id])

  @@index([userId])
  @@index([grantedById])
  @@index([grantedAt])
  @@map("finalquizretakegrant")
}

model DailySubmission {
  id               String         @id @default(cuid())
  userId           String
  dayNumber        Int
  // Kept for legacy uniqueness; new submissions use "DAILY" (phases removed from UI).
  phase            String         @default("DAILY")
  projectId        String?
  sopRead          Boolean        @default(false)
  // Production units completed (count), not a percentage.
  tasksCompleted   Int            @default(0)
  productivityPct  Float?
  qualityPct       Float?
  issues           String?
  learningComplete Boolean        @default(false)
  submittedAt      DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project          Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  qaReview         QAReview?
  trainerReview    TrainerReview?

  @@unique([userId, dayNumber, phase])
  @@index([projectId], map: "DailySubmission_projectId_fkey")
  @@map("dailysubmission")
}

model QAReview {
  id           String          @id @default(cuid())
  submissionId String          @unique
  reviewerId   String
  feedback     String?
  errorCount   Int             @default(0)
  qualityScore Float?
  status       String          @default("PENDING")
  reviewedAt   DateTime?
  reviewer     User            @relation("QAReviewer", fields: [reviewerId], references: [id])
  submission   DailySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([reviewerId], map: "QAReview_reviewerId_fkey")
  @@map("qareview")
}

model TrainerReview {
  id           String          @id @default(cuid())
  submissionId String          @unique
  reviewerId   String
  remarks      String?
  // Quality score is set by Team Lead / Admin, not by the employee.
  qualityScore Float?
  status       String          @default("PENDING")
  reviewedAt   DateTime?
  reviewer     User            @relation("TrainerReviewer", fields: [reviewerId], references: [id])
  submission   DailySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([reviewerId], map: "TrainerReview_reviewerId_fkey")
  @@map("trainerreview")
}

/// Optional Team Lead feedback on a trainee's completed curriculum day
model DayWorkReview {
  id         String   @id @default(cuid())
  traineeId  String
  dayNumber  Int
  reviewerId String
  notes      String?  @db.Text
  rating     Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  trainee    User     @relation("DayWorkTrainee", fields: [traineeId], references: [id], onDelete: Cascade)
  reviewer   User     @relation("DayWorkReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([traineeId, dayNumber])
  @@index([traineeId])
  @@index([reviewerId])
  @@map("dayworkreview")
}

/// Manual training work metrics entered by Admin / Team Lead (replaces live HRMS fetch).
model TraineeWorkMetric {
  id               String   @id @default(cuid())
  traineeId        String
  dayNumber        Int
  projectName      String?
  hoursLogged      Float?
  productionUnits  Float?
  /// Quality score 0–100
  qualityScore     Float?
  notes            String?  @db.Text
  recordedById     String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  trainee          User     @relation("WorkMetricTrainee", fields: [traineeId], references: [id], onDelete: Cascade)
  recordedBy       User     @relation("WorkMetricRecorder", fields: [recordedById], references: [id], onDelete: Cascade)

  @@unique([traineeId, dayNumber])
  @@index([traineeId])
  @@index([recordedById])
  @@map("traineeworkmetric")
}

/// Key/value JSON config (e.g. certificate branding).
model AppConfig {
  id          String   @id
  value       Json
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("appconfig")
}

model ProjectCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String?  @unique
  description String?
  status      String   @default("ACTIVE")
  createdBy   String
  creator     User     @relation("CategoryCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  projects    Project[] @relation("ProjectCategoryRelation")
  @@map("projectcategory")
}

model Project {
  id             String                 @id @default(cuid())
  name           String
  description    String?
  categoryId     String?
  categoryRel    ProjectCategory? @relation("ProjectCategoryRelation", fields: [categoryId], references: [id], onDelete: SetNull)
  status         String   @default("ACTIVE")
  startDate      DateTime?
  endDate        DateTime?
  priority       String                 @default("MEDIUM")
  resources      String?
  documentation  String?
  url            String?
  createdBy      String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  active         Boolean                @default(true)
  creator        User                   @relation("ProjectCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  assignments      ProjectAssignment[]
  certifications   ProjectCertification[]
  dailySubmissions DailySubmission[]

  @@index([createdBy], map: "Project_createdBy_fkey")
  @@index([categoryId], map: "Project_categoryId_fkey")
}

model ProjectAssignment {
  id         String   @id @default(cuid())
  projectId  String
  userId     String
  assignedBy String
  assignedAt DateTime @default(now())
  status     String   @default("ASSIGNED")
  assigner   User     @relation("AssignmentCreator", fields: [assignedBy], references: [id])
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User     @relation("ProjectAssignments", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([assignedBy], map: "ProjectAssignment_assignedBy_fkey")
  @@index([userId], map: "ProjectAssignment_userId_fkey")
  @@map("projectassignment")
}
