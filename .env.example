# --- Local development (XAMPP MySQL) ---
# DATABASE_URL="mysql://root@127.0.0.1:3306/tms_local"
#
# --- Remote / production ---
# DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:3306/DATABASE_NAME"
# Example: DATABASE_URL="mysql://u123456789:password@mysql.hostinger.com:3306/u123456789_tms"
#
# Keep a copy of remote when switching to local:
# DATABASE_URL_REMOTE="mysql://USERNAME:PASSWORD@HOST:3306/tms_prod"

DATABASE_URL="mysql://root@127.0.0.1:3306/tms_local"

# Optional: HRMS — use your local XAMPP DB (tfs_hrms)
# HRMS_DATABASE_URL="mysql://root@127.0.0.1:3306/tfs_hrms"

# Optional: external production Tracker database (read-only)
# TRACKER_DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:3306/TRACKER_DB"
# TRACKER_USER_KEY=email

# SQLite (legacy / migration only)
# SQLITE_DATABASE_URL="file:./dev.db"

