# MySQL Database for Hostinger Deployment
# Replace with your Hostinger MySQL database credentials
DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:3306/DATABASE_NAME"

# Example: DATABASE_URL="mysql://u123456789:password@mysql.hostinger.com:3306/u123456789_tms"

# Optional: HRMS (mytfs) database for read-only project list
# If unset, TMS derives it from DATABASE_URL by swapping the DB name to mytfs.
# HRMS_DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:3306/mytfs"
# HRMS_DATABASE_NAME=mytfs

# Optional: external production Tracker database (read-only)
# When set, TMS shows production work after training completes (≥90%).
# TRACKER_DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:3306/TRACKER_DB"
# Map TMS users to tracker rows by email (default) or employeeId:
# TRACKER_USER_KEY=email

# SQLite (for local development only - not used in production)
# SQLITE_DATABASE_URL="file:./dev.db"
# change this to your hostinger database credentials

# App Configuration
APP_NAME=Training Management System
BASE_URL=http://localhost:3000

# Email Configuration (SMTP)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=tfsoperation@transformsolution.net
SMTP_PASS=wshtdwxdgftljmbf
SMTP_FROM_NAME=Transform Solution

# Password Reset Configuration
RESET_TOKEN_EXPIRY_MINUTES=15
OTP_LENGTH=6

# Rate Limiting Configuration
RATE_LIMIT_MAX_REQUESTS=3
RATE_LIMIT_WINDOW_MINUTES=10
